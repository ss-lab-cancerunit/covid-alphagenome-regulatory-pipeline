#!/usr/bin/env bash
#PBS -N lnc6k_post
#PBS -l walltime=00:45:00
#PBS -l select=1:ncpus=2:mem=24gb
#PBS -j oe

set -euo pipefail

PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:-}}"
if [[ -z "$PROJECT_ROOT" || ! -d "$PROJECT_ROOT/src/covid_agpt" ]]; then
  echo "Submit from the repository root or pass -v PROJECT_ROOT=/path/to/repo" >&2
  exit 2
fi
cd "$PROJECT_ROOT"

eval "$(~/miniforge3/bin/conda shell.bash hook)"
conda activate agpt

export AGPT_REPO="$PROJECT_ROOT/external/alphagenome_pytorch_screen_noviz"
export PYTHONPATH="$PROJECT_ROOT/src:$AGPT_REPO/src:$AGPT_REPO:${PYTHONPATH:-}"

python scripts/02_postprocess/run_postprocess.py \
  --branch lnc_gwas_6268snvs_formal_lnc_total \
  --outdir "$PROJECT_ROOT/results/lnc_gwas_6268snvs_formal_lnc_total" \
  --expected-n-input 6268 \
  --expected-n-batches 32 \
  --variant-col variant_id \
  --rel-col rel \
  --act-col act \
  --selection-mode best_per_snv
